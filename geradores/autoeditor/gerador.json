{
  "schema": "videoforge/generator/v1",
  "id": "autoeditor",
  "nome": "AutoEditor — gerador modular de vídeos",
  "descricao": "Pipeline real inspirado no AutoEditorVideo: pauta, roteiro, Edge TTS com WordBoundary, imagens pelo Codex Proxy, cenas dinâmicas Remotion MasterShort, FFprobe e revisão. Independente do nicho.",
  "status": "ready_for_backend",
  "execution_enabled": false,
  "auto_publish_enabled": false,
  "requires_human_approval": true,
  "perfil": {
    "publico": "adaptavel a qualquer canal",
    "estilo": "estilo por vídeo, imagem mestre e camadas RGBA derivadas da mesma cena; animação de câmera e personagem com QA",
    "direcao": "arte só pelo Codex Proxy no VideoForge; cena mestre, fundo sem personagem, camadas RGBA transparentes de personagens e props móveis; animador compõe camadas no Remotion, revisor visual confere transparência e pede inspeção estética independente; sem upload automático"
  },
  "pipeline": [
    {
      "id": "pauta",
      "operation": "editorial-brief",
      "agent": "coordenador-pautas",
      "after": [],
      "output": "briefing.json"
    },
    {
      "id": "anti-duplicacao",
      "operation": "dedup-check",
      "agent": "pesquisador",
      "after": [
        "pauta"
      ],
      "output": "deduplicacao.json"
    },
    {
      "id": "roteiro",
      "operation": "script",
      "agent": "roteirista-cenas",
      "after": [
        "anti-duplicacao"
      ],
      "output": "roteiro.json"
    },
    {
      "id": "storyboard",
      "operation": "storyboard",
      "agent": "storyboard",
      "after": [
        "roteiro"
      ],
      "output": "storyboard.json"
    },
    {
      "id": "narracao",
      "operation": "narration",
      "agent": "voz",
      "after": [
        "roteiro"
      ],
      "output": "narracao.mp3"
    },
    {
      "id": "legendas",
      "operation": "captions",
      "agent": "legendas",
      "after": [
        "narracao"
      ],
      "output": "legendas.json"
    },
    {
      "id": "imagens",
      "operation": "image-generation",
      "agent": "ilustrador",
      "after": [
        "storyboard",
        "narracao"
      ],
      "output": "imagens.json",
      "source": "integrated-image-generator"
    },
    {
      "id": "decomposicao",
      "operation": "layer-extraction",
      "agent": "ilustrador",
      "after": [
        "imagens"
      ],
      "output": "scene-layers.json"
    },
    {
      "id": "qa-camadas",
      "operation": "layer-technical-review",
      "agent": "revisor-visual",
      "after": [
        "decomposicao"
      ],
      "output": "qa-camadas.json"
    },
    {
      "id": "qa-imagens",
      "operation": "visual-review",
      "agent": "revisor-visual",
      "after": [
        "qa-camadas"
      ],
      "output": "qa-imagens.json"
    },
    {
      "id": "animacao",
      "operation": "animation-composition",
      "agent": "animacao",
      "after": [
        "qa-imagens",
        "legendas"
      ],
      "output": "remotion-props.json"
    },
    {
      "id": "edicao",
      "operation": "render",
      "agent": "montagem",
      "after": [
        "animacao"
      ],
      "output": "video.mp4"
    },
    {
      "id": "qa-tecnico",
      "operation": "technical-review",
      "agent": "qa-tecnico",
      "after": [
        "edicao"
      ],
      "output": "qa-tecnico.json"
    },
    {
      "id": "qa-editorial",
      "operation": "quality-review",
      "agent": "revisor-conteudo",
      "after": [
        "qa-tecnico"
      ],
      "output": "qa-editorial.json"
    }
  ]
}
